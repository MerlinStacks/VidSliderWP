<?xml version="1.0"?>
<ruleset name="Reel It">
    <description>WordPress coding standards for Reel It.</description>

    <file>reel-it.php</file>
    <file>uninstall.php</file>
    <file>admin</file>
    <file>blocks</file>
    <file>includes</file>
    <file>public</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>

    <config name="minimum_supported_wp_version" value="5.8"/>
</ruleset>
